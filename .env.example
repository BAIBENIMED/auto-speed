# Copiez ce fichier en .env (racine et/ou server/) et renseignez vos valeurs.
# Aucune valeur reelle ne doit jamais etre commitee dans ce fichier.

# --- Base de donnees --------------------------------------------------------
# Soit DATABASE_URL seule, soit le detail DB_* ci-dessous.
DATABASE_URL=
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Authentification --------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=24h

# --- Serveur -----------------------------------------------------------------
PORT=5000
NODE_ENV=production
# Domaines additionnels autorises en CORS, separes par des virgules
ALLOWED_ORIGINS=
APP_URL=

# --- Suivi maritime (Sinay / SafeCube) ---------------------------------------
SAFECUBE_API_KEY=
# Delai d'attente de l'API en millisecondes (defaut 75000)
SINAY_TIMEOUT_MS=75000

# --- Courriel (SMTP) ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Sauvegardes de la base ----------------------------------------------------
# Destinataire des sauvegardes automatiques (optionnel, sans quoi elles restent
# uniquement sur le disque du serveur, qui peut etre efface au redeploiement)
BACKUP_EMAIL=
# Dossier de stockage local (defaut : server/backups)
BACKUP_DIR=
# Nombre de sauvegardes conservees (defaut 14)
BACKUP_RETENTION=14

# --- Pieces jointes ------------------------------------------------------------
# Taille maximale d'un fichier televerse, en Mo (defaut 15)
UPLOAD_MAX_MB=15
